# =============================================================================
# SamaanX — Environment Variables
# Copy to `.env` and `.env.local` for local development.
# Never put real secrets in this file — it is committed to git.
# =============================================================================

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="SamaanX"

# Database (Supabase Postgres)
# Transaction pooler (IPv4) — app / Prisma queries
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler — migrations
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Required in production (Vercel) — powers server Realtime broadcast for chat + peer sync.

# Auth providers configured in Supabase dashboard (Email + Google for MVP).

# Super Admin (Phase 10) — single ops account; promote via SQL after signup
SUPER_ADMIN_EMAIL="superadmin@yourdomain.com"
SUPER_ADMIN_PASSWORD=""

# Resend — transactional email (Phase 9)
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="SamaanX <onboarding@resend.dev>"

# Web Push (generate VAPID keys — keep private server-only)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BGHQ4TJ9jIdANKlOMFRCIx1MVshocjK0jkATzVOeRUMnSlQ6YUgl5TUbRnYOWieANOY4iQbjbA64zWaoOnliSBw"
VAPID_PRIVATE_KEY="cyi3ZhRtI4IVu4ViJo_gdM9bB37Tqzta07Fxs-GYXI8"

# Cron / background jobs
CRON_SECRET="replace-with-long-random-string"

# Geoapify — address autocomplete and geocoding (OpenStreetMap data)
# https://myprojects.geoapify.com/
NEXT_PUBLIC_GEOAPIFY_API_KEY=""

# Analytics & growth (Phase 11) — optional for local dev
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_CLARITY_ID=""
NEXT_PUBLIC_GSC_VERIFICATION=""

# Performance diagnostics — set to "1" in Vercel to log route summaries
PERF_LOG=""
PERF_REQUEST_SUMMARY=""

# Sentry — error monitoring (Session 4)
# https://samaanx.sentry.io/
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Optional: upload source maps in CI
SENTRY_AUTH_TOKEN=""
# Set to "1" in production to allow GET /api/test/sentry-error with Bearer CRON_SECRET
ENABLE_SENTRY_TEST=""

# QR / PIN signing — required for handover & return verification (Phase 5C)
# Use a long random string (32+ chars). Never commit real secrets.
VERIFICATION_HMAC_SECRET="replace-with-long-random-string"
