# =============================================================================
# RentPe — Environment Variables
# Copy to `.env.local` for local development. Never commit real secrets.
# =============================================================================

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="RentPe"

# Database (Supabase Postgres)
# Use the Transaction pooler URL for serverless (Prisma on Vercel).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Direct connection (migrations) — optional but recommended
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Auth providers configured in Supabase dashboard (Email + Google for MVP).

# Resend — later phases
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="RentPe <noreply@yourdomain.com>"

# Google Maps — later phases
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-key"

# QR / PIN signing — later phases
VERIFICATION_HMAC_SECRET="replace-with-long-random-string"
