    "@types/react-dom": "^19",
    "dotenv": "^16.5.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^6.19.0",
    "sharp": "^0.34.2",
    "tailwindcss": "^4",
    "typescript": "^5"
